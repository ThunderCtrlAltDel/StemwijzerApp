<Page x:Class="StemwijzerApp.Pages.PartijDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="PartijDetailPage" Background="#EDF2F4">

    <Page.Resources>

        <!-- Positie-knop stijl (Eens / Neutraal / Oneens) -->
        <Style x:Key="PositieButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EDF2F4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Geselecteerde positie-knop -->
        <Style x:Key="PositieButtonSelectedStyle" TargetType="Button"
               BasedOn="{StaticResource PositieButtonStyle}">
            <Setter Property="Background" Value="#1A202C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1A202C"/>
        </Style>

        <!-- Opslaan-knop -->
        <Style x:Key="OpslaanButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A202C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Style.Resources>
        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30" MaxWidth="1200">

            <!-- ── Terug-knop ─────────────────────────────────────────────── -->
            <Button HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,0,0,20"
                    Click="TerugButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x2190;" FontSize="16" Foreground="#4A5568" 
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Terug naar overzicht" FontSize="14"
                               Foreground="#4A5568" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- ── Partij-header kaart ────────────────────────────────────── -->
            <Border Background="White" CornerRadius="12" Padding="24" Margin="0,0,0,24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" Direction="270" Opacity="0.08" ShadowDepth="2"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Kleur-badge met afkorting -->
                    <Border x:Name="PartijBadge"
                            Width="64" Height="64"
                            CornerRadius="12"
                            Background="{Binding PartijKleur}"
                            Margin="0,0,20,0">
                        <TextBlock x:Name="AfkortingLabel"
                                   Text="{Binding Afkorting}"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <!-- Naam + beschrijving -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="NaamLabel"
                                   Text="{Binding Naam}"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="#1A202C"/>
                        <TextBlock x:Name="BeschrijvingLabel"
                                   Text="{Binding Beschrijving}"
                                   FontSize="14" Foreground="#718096"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── Standpunten sectie ─────────────────────────────────────── -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StandpuntenTitel}"
                           FontSize="20" FontWeight="Bold"
                           Foreground="#1A202C"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Style="{StaticResource OpslaanButtonStyle}"
                        Click="OpslaanButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Opslaan" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ── Lijst met standpunt-kaarten ───────────────────────────── -->
            <ItemsControl x:Name="StandpuntenList" ItemsSource="{Binding Standpunten}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="12"
                                Padding="24" Margin="0,0,0,16">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Direction="270"
                                                  Opacity="0.07" ShadowDepth="2"/>
                            </Border.Effect>
                            <StackPanel>

                                <!-- Titel + beschrijving stelling -->
                                <TextBlock Text="{Binding Titel}"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="#1A202C"/>
                                <TextBlock Text="{Binding StellingTekst}"
                                           FontSize="13" Foreground="#718096"
                                           Margin="0,4,0,10"
                                           TextWrapping="Wrap"/>

                                <!-- Categorie-tag -->
                                <Border Background="#EDF2F4" CornerRadius="20"
                                        Padding="12,4" HorizontalAlignment="Left"
                                        Margin="0,0,0,16">
                                    <TextBlock Text="{Binding Categorie}"
                                               FontSize="12" Foreground="#4A5568"/>
                                </Border>

                                <!-- Positie-label -->
                                <TextBlock Text="Positie" FontSize="13"
                                           FontWeight="SemiBold" Foreground="#2D3748"
                                           Margin="0,0,0,8"/>

                                <!-- Positie-knoppen -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Content="Eens"
                                            Tag="{Binding}"
                                            Click="PositieEens_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PositieButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Positie}" Value="Eens">
                                                        <Setter Property="Background" Value="#1A202C"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="BorderBrush" Value="#1A202C"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Grid.Column="2"
                                            Content="Neutraal"
                                            Tag="{Binding}"
                                            Click="PositieNeutraal_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PositieButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Positie}" Value="Neutraal">
                                                        <Setter Property="Background" Value="#1A202C"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="BorderBrush" Value="#1A202C"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Grid.Column="4"
                                            Content="Oneens"
                                            Tag="{Binding}"
                                            Click="PositieOneens_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PositieButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Positie}" Value="Oneens">
                                                        <Setter Property="Background" Value="#1A202C"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="BorderBrush" Value="#1A202C"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>

                                <!-- Toelichting -->
                                <TextBlock Text="Toelichting" FontSize="13"
                                           FontWeight="SemiBold" Foreground="#2D3748"
                                           Margin="0,0,0,8"/>
                                <Border BorderBrush="#CBD5E0" BorderThickness="1"
                                        CornerRadius="8">
                                    <TextBox Text="{Binding Toelichting, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0"
                                             Padding="12"
                                             FontSize="13"
                                             Foreground="#2D3748"
                                             Background="White"
                                             MinHeight="80"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"/>
                                </Border>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>
