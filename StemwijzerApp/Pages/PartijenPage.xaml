<Page x:Class="StemwijzerApp.Pages.PartijenPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1300"
      Title="PartijenPage" Background="#EDF2F4">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Politieke Partijen"
                       FontSize="24"
                       VerticalAlignment="Center"
                       Grid.Column="0"
                       Foreground="#2D3748"/>

            <Button Content="+ Nieuwe Partij"
                    Style="{StaticResource HeaderAccentButtonStyle}"
                    Grid.Column="2"
                    VerticalAlignment="Center"/>
        </Grid>

        <!-- DataGrid -->
        <DataGrid Grid.Row="2"
                  Style="{StaticResource ModernDataGridStyle}"
                  ItemsSource="{Binding Partijen}"
                  SelectionChanged="DataGrid_SelectionChanged"
                  AutoGenerateColumns="False">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Afkorting"
                                    Binding="{Binding Afkorting}"
                                    Width="1.5*"
                                    ElementStyle="{StaticResource DataGridTextStyle}"/>

                <DataGridTextColumn Header="Naam"
                                    Binding="{Binding Naam}"
                                    Width="3.5*"
                                    ElementStyle="{StaticResource DataGridTextStyle}"/>

                <DataGridTextColumn Header="Beschrijving"
                                    Binding="{Binding Beschrijving}"
                                    Width="4*"
                                    ElementStyle="{StaticResource DataGridTextStyle}"/>

                <DataGridTemplateColumn Header="Kleur" Width="1.5*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Kleur}"
                                    Width="24" Height="24"
                                    CornerRadius="4"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="15,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Acties" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="10,0">
                                <Button Content="👁"
                                        Style="{StaticResource DataGridActionButtonStyle}"
                                        Foreground="#2D3748"/>
                                <Button Content="✎"
                                        Style="{StaticResource DataGridActionButtonStyle}"
                                        Foreground="#2D3748"/>
                                <Button Content="🗑"
                                        Style="{StaticResource DataGridActionButtonStyle}"
                                        Foreground="Red"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Page>