<Page x:Class="StemwijzerApp.Pages.PartijenPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:StemwijzerApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="PartijenPage" Background="#EDF2F4">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="20"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Politieke Partijen" 
                       FontSize="32" 
                       FontWeight="Bold" 
                       Foreground="#2D3748" 
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1" 
                    Width="240" Height="50" 
                    Background="#FF020247" 
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="18"
                    FontWeight="SemiBold">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </Button.Resources>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="+" Margin="0,0,10,0" FontSize="24" VerticalAlignment="Center"/>
                    <TextBlock Text="Nieuwe Partij" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <DataGrid Grid.Row="2" Style="{StaticResource ModernDataGridStyle}" SelectionChanged="DataGrid_SelectionChanged">

            <DataGrid.Items>
                <local:VoorbeeldPartij
                    Afkorting="VVD"
                    Naam="Volkspartij voor Vrijheid en Democratie"
                    Beschrijving="Liberale partij"
                    HexKleur="#FF6B00" />
                <local:VoorbeeldPartij
                    Afkorting="PvdA"
                    Naam="Partij van de Arbeid"
                    Beschrijving="Sociaaldemocratische partij"
                    HexKleur="#DF0031" />
                <local:VoorbeeldPartij
                    Afkorting="PVV"
                    Naam="Partij voor de Vrijheid"
                    Beschrijving="Rechtse populistische partij"
                    HexKleur="#007BC7" />
                <local:VoorbeeldPartij
                    Afkorting="GL"
                    Naam="GroenLinks"
                    Beschrijving="Groene en linkse partij"
                    HexKleur="#7AB800" />
                <local:VoorbeeldPartij
                    Afkorting="D66"
                    Naam="Democraten 66"
                    Beschrijving="Sociaal-liberale partij"
                    HexKleur="#00AE42" />
                <local:VoorbeeldPartij
                    Afkorting="CDA"
                    Naam="Christen-Democratisch Appèl"
                    Beschrijving="Christendemocratische partij"
                    HexKleur="#007D5C" />
                <local:VoorbeeldPartij
                    Afkorting="SP"
                    Naam="Socialistische Partij"
                    Beschrijving="Socialistische partij"
                    HexKleur="#FF0000" />
                <local:VoorbeeldPartij
                    Afkorting="CU"
                    Naam="ChristenUnie"
                    Beschrijving="Christelijk-sociale partij"
                    HexKleur="#00A7EB" />
                <local:VoorbeeldPartij
                    Afkorting="PvdD"
                    Naam="Partij voor de Dieren"
                    Beschrijving="Dierenrechtenpartij"
                    HexKleur="#006B2D" />
            </DataGrid.Items>

            <DataGrid.Columns>

                <DataGridTextColumn Header="Afkorting"
                                    Binding="{Binding Afkorting}"
                                    Width="1.5*"
                                    ElementStyle="{StaticResource DataGridTextStyle}"/>

                <DataGridTextColumn Header="Naam"
                                    Binding="{Binding Naam}"
                                    Width="3.5*"
                                    ElementStyle="{StaticResource DataGridTextStyle}"/>

                <DataGridTextColumn Header="Beschrijving"
                                    Binding="{Binding Beschrijving}"
                                    Width="4*"
                                    ElementStyle="{StaticResource DataGridTextStyle}"/>

                    <DataGridTemplateColumn Header="Kleur" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="30" Height="20" CornerRadius="4" 
                                        Background="{Binding Kleur}" 
                                        HorizontalAlignment="Left" Margin="10,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Acties" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button Width="32" Height="32" Margin="4,0" Background="Transparent" BorderThickness="0" ToolTip="Bekijk">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A8;" FontSize="16" Foreground="#4A5568"/>
                                    </Button>
                                    <Button Width="32" Height="32" Margin="4,0" Background="Transparent" BorderThickness="0" ToolTip="Bewerken">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" FontSize="16" Foreground="#4A5568"/>
                                    </Button>
                                    <Button Width="32" Height="32" Margin="4,0" Background="Transparent" BorderThickness="0" ToolTip="Verwijderen">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="16" Foreground="#E53E3E"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>