<Page x:Class="StemwijzerApp.Pages.PartijenPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:StemwijzerApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="1100" d:DesignWidth="1300"
      Title="PartijenPage" Background="blue">

    <Grid>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="50" Text="Partijen"></TextBlock>
        
        
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="50" FontWeight="Bold" Text="Politieke Partijen" Margin="-790,-800,0,0"></TextBlock>
        <Border Width="1200" Height="100" CornerRadius="10" Padding="5" Background="#FFF0E2C8" BorderThickness="0" Margin="0,-500,0,0">
            <StackPanel Width="1200" Height="100">
                <TextBlock FontWeight="Bold" Width="150" Height="40" FontSize="28" Margin="-985,10,0,0">Afkorting</TextBlock>
                <TextBlock FontWeight="Bold" Width="150" Height="40" FontSize="28" Margin="-500,-40,0,0">Naam</TextBlock>
                <TextBlock FontWeight="Bold" Width="170" Height="40" FontSize="28" Margin="0,-40,0,0">Beschrijving</TextBlock>
                <TextBlock FontWeight="Bold" Width="150" Height="40" FontSize="28" Margin="500,-40,0,0">Kleur</TextBlock>
                <TextBlock FontWeight="Bold" Width="150" Height="40" FontSize="28" Margin="900,-40,0,0">Acties</TextBlock>
            </StackPanel>
        </Border>
        <ListBox Width="1000" Height="600" Margin="0,210,0,0">
            <TextBlock></TextBlock>
        </ListBox>
    </Grid>
</Page>
