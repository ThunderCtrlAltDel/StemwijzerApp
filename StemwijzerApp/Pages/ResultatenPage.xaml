<Page x:Class="StemwijzerApp.Pages.ResultatenPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:StemwijzerApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1300" Background="#EDF2F4"
      Title="ResultatenPage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="20"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Stemwijzer Resultaten" FontSize="24" VerticalAlignment="Center" Grid.Column="0" Foreground="#2D3748"></TextBlock>
            <Button Content="+ Nieuw Resultaat" Style="{StaticResource HeaderAccentButtonStyle}" Grid.Column="2" VerticalAlignment="Center"></Button>
        </Grid>

        <DataGrid Grid.Row="2" Style="{StaticResource ModernDataGridStyle}" SelectionChanged="DataGrid_SelectionChanged">

            <DataGrid.Items>
                <local:VoorbeeldResultaat
                    Gebruiker="Jan Jansen"
                    Verkiezing="Tweede Kamerverkiezingen 2025"
                    Voortgang="2/15"
                    BesteMatch="PvdA"
                    OvereenkomstWaarde="100"
                    Datum="20-11-2024" />
            </DataGrid.Items>

            <DataGrid.Columns>

                <DataGridTextColumn Header="Gebruiker"
                                    Binding="{Binding Gebruiker}"
                                    Width="2*"
                                    ElementStyle="{StaticResource DataGridTextStyle}"/>

                <DataGridTextColumn Header="Verkiezing"
                                    Binding="{Binding Verkiezing}"
                                    Width="3.5*"
                                    ElementStyle="{StaticResource DataGridTextStyle}"/>

                <DataGridTemplateColumn Header="Voortgang" Width="1.5*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="#EAEAEA"
                                    Height="24"
                                    CornerRadius="12"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Padding="12,0"
                                    Margin="15,0">
                                <TextBlock Text="{Binding Voortgang}"
                                           Foreground="#2D3748"
                                           FontSize="13"
                                           FontWeight="Normal"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Beste match"
                                    Binding="{Binding BesteMatch}"
                                    Width="1.5*"
                                    ElementStyle="{StaticResource DataGridTextStyle}"/>

                <DataGridTemplateColumn Header="Overeenkomst" Width="2.5*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0">
                                <ProgressBar Value="{Binding OvereenkomstWaarde}" 
                                             Maximum="100" 
                                             Style="{StaticResource RoundedProgressBarStyle}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding OvereenkomstWaarde, StringFormat={}{0}%}" 
                                           Foreground="#2D3748" 
                                           FontSize="14" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Datum"
                                    Binding="{Binding Datum}"
                                    Width="1.5*"
                                    ElementStyle="{StaticResource DataGridTextStyle}"/>

                <DataGridTemplateColumn Header="Acties" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10,0">
                                <Button Content="👁" Style="{StaticResource DataGridActionButtonStyle}" Foreground="#2D3748" />
                                <Button Content="🗑" Style="{StaticResource DataGridActionButtonStyle}" Foreground="Red" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</Page>