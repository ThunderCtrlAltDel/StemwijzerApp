<Page x:Class="StemwijzerApp.Pages.ResultatenPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:StemwijzerApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="1000" d:DesignWidth="1300" Background="#EDF2F4"
      Title="ResultatenPage">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Stemwijzer Resultaten" FontSize="24" VerticalAlignment="Center" Grid.Column="0" Foreground="#2D3748"></TextBlock>
                <Button Content="+ Nieuw Resultaat" Style="{StaticResource HeaderAccentButtonStyle}" Grid.Column="2" VerticalAlignment="Center" Click="NieuwResultaat_Click"></Button>
            </Grid>

            <Border x:Name="NieuwResultaatForm" Grid.Row="1" Background="White" CornerRadius="8" Padding="25" Margin="0,20,0,20" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="LblFormTitel" Text="Nieuw Resultaat Toevoegen" FontSize="18" FontWeight="Bold" Foreground="#2D3748" Margin="0,0,0,20"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="25"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,0,25">
                            <TextBlock Text="Gebruiker" FontWeight="SemiBold" FontSize="14" Foreground="#2D3748" Margin="0,0,0,8"/>
                            <ComboBox x:Name="CmbGebruiker" 
                                      Style="{StaticResource ModernComboBoxStyle}" 
                                      Height="40"
                                      ItemsSource="{Binding BeschikbareGebruikers}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock VerticalAlignment="Center">
                                            <Run Text="{Binding Voornaam}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding Achternaam}"/>
                                            <Run Text=" ("/>
                                            <Run Text="{Binding Gebruikersnaam}"/>
                                            <Run Text=")"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,0,25">
                            <TextBlock Text="Verkiezing" FontWeight="SemiBold" FontSize="14" Foreground="#2D3748" Margin="0,0,0,8"/>
                            <TextBox x:Name="TxtVerkiezing" Style="{StaticResource ModernTextBoxStyle}" Height="40"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnToevoegen" Content="Toevoegen en Antwoorden Invullen" Style="{StaticResource FormPrimaryButtonStyle}" Padding="15,0" Margin="0,0,10,0" Click="Toevoegen_Click"/>
                        <Button Content="Annuleren" Style="{StaticResource FormSecondaryButtonStyle}" Width="110" Click="Annuleren_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="AntwoordenInvullenForm" Grid.Row="2" Margin="0,20,0,20" Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="7*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="25">
                            <StackPanel>
                                <TextBlock Text="Stemwijzer Resultaat" FontSize="20" FontWeight="Bold" Foreground="#2D3748" Margin="0,0,0,15"/>
                                <TextBlock Margin="0,4" FontSize="14">
                                    <Run Text="Gebruiker:" Foreground="#A0AEC0"/>
                                    <Run x:Name="LblResultaatGebruiker" FontWeight="SemiBold" Foreground="#2D3748"/>
                                </TextBlock>
                                <TextBlock Margin="0,4" FontSize="14">
                                    <Run Text="E-mail:" Foreground="#A0AEC0"/>
                                    <Run x:Name="LblResultaatEmail" Foreground="#2D3748"/>
                                </TextBlock>
                                <TextBlock Margin="0,4" FontSize="14">
                                    <Run Text="Verkiezing:" Foreground="#A0AEC0"/>
                                    <Run x:Name="LblResultaatVerkiezing" Foreground="#2D3748"/>
                                </TextBlock>
                                <TextBlock Margin="0,4" FontSize="14">
                                    <Run Text="Voortgang:" Foreground="#A0AEC0"/>
                                    <Run x:Name="LblResultaatVoortgang" Foreground="#2D3748" Text="0 van 2 vragen beantwoord"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="25">
                            <StackPanel>
                                <TextBlock Text="Beste Match" FontSize="16" FontWeight="SemiBold" Foreground="#2D3748" Margin="0,0,0,15"/>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#FF6B00" CornerRadius="6" Width="45" Height="45" VerticalAlignment="Center">
                                        <TextBlock Text="VVD" Foreground="White" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="VVD" FontSize="14" Foreground="#2D3748" FontWeight="SemiBold"/>
                                        <TextBlock Text="0%" FontSize="20" Foreground="#2D3748" FontWeight="Bold"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Margin="0,10,0,15">
                        <TextBlock Text="Antwoorden Bewerken" FontSize="18" FontWeight="Bold" Foreground="#2D3748" VerticalAlignment="Center"/>
                        <Button Content="💾 Opslaan" HorizontalAlignment="Right" Style="{StaticResource FormPrimaryButtonStyle}" Width="100" Click="OpslaanAntwoorden_Click"/>
                    </Grid>

                    <Border Background="White" CornerRadius="8" Padding="25" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Meer windmolens bouwen" FontSize="15" FontWeight="Bold" Foreground="#2D3748"/>
                            <TextBlock Text="Er moeten meer windmolens gebouwd worden voor duurzame energie" FontSize="13" Foreground="#A0AEC0" Margin="0,5,0,10"/>
                            <Border Background="#E2E8F0" CornerRadius="10" HorizontalAlignment="Left" Padding="12,4">
                                <TextBlock Text="Klimaat" FontSize="12" Foreground="#718096" FontWeight="Medium"/>
                            </Border>
                            <TextBlock Text="Antwoord van gebruiker" FontSize="13" FontWeight="SemiBold" Foreground="#2D3748" Margin="0,15,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton Grid.Column="0" Content="Eens" Style="{StaticResource TypeRadioButtonStyle}" Height="40" GroupName="Q1"/>
                                <RadioButton Grid.Column="2" Content="Neutraal" Style="{StaticResource TypeRadioButtonStyle}" Height="40" GroupName="Q1"/>
                                <RadioButton Grid.Column="4" Content="Oneens" Style="{StaticResource TypeRadioButtonStyle}" Height="40" GroupName="Q1"/>
                                <RadioButton Grid.Column="6" Content="Geen antwoord" Style="{StaticResource TypeRadioButtonStyle}" Width="130" Height="40" GroupName="Q1" IsChecked="True"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="8" Padding="25" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="Belastingverlaging middeninkomens" FontSize="15" FontWeight="Bold" Foreground="#2D3748"/>
                            <TextBlock Text="De belastingen moeten omlaag voor middeninkomens" FontSize="13" Foreground="#A0AEC0" Margin="0,5,0,10"/>
                            <Border Background="#E2E8F0" CornerRadius="10" HorizontalAlignment="Left" Padding="12,4">
                                <TextBlock Text="Economie" FontSize="12" Foreground="#718096" FontWeight="Medium"/>
                            </Border>
                            <TextBlock Text="Antwoord van gebruiker" FontSize="13" FontWeight="SemiBold" Foreground="#2D3748" Margin="0,15,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton Grid.Column="0" Content="Eens" Style="{StaticResource TypeRadioButtonStyle}" Height="40" GroupName="Q2"/>
                                <RadioButton Grid.Column="2" Content="Neutraal" Style="{StaticResource TypeRadioButtonStyle}" Height="40" GroupName="Q2"/>
                                <RadioButton Grid.Column="4" Content="Oneens" Style="{StaticResource TypeRadioButtonStyle}" Height="40" GroupName="Q2"/>
                                <RadioButton Grid.Column="6" Content="Geen antwoord" Style="{StaticResource TypeRadioButtonStyle}" Width="130" Height="40" GroupName="Q2" IsChecked="True"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <DataGrid x:Name="MainDataGrid" Grid.Row="3" 
                      Style="{StaticResource ModernDataGridStyle}" 
                      ItemsSource="{Binding Resultaten}"
                      SelectionChanged="DataGrid_SelectionChanged"
                      VerticalScrollBarVisibility="Disabled"
                      PreviewMouseWheel="DataGrid_PreviewMouseWheel">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Gebruiker" Binding="{Binding VolledigeNaam}" Width="3*" ElementStyle="{StaticResource DataGridTextStyle}"/>
                    <DataGridTextColumn Header="Verkiezing" Binding="{Binding Verkiezing}" Width="3*" ElementStyle="{StaticResource DataGridTextStyle}"/>
                    <DataGridTextColumn Header="Datum" Binding="{Binding Datum}" Width="2*" ElementStyle="{StaticResource DataGridTextStyle}"/>

                    <DataGridTemplateColumn Header="Status" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#EAEAEA" Height="24" CornerRadius="12" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="12,0" Margin="15,0">
                                    <TextBlock Text="{Binding Status}" Foreground="#2D3748" FontSize="13" VerticalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Acties" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10,0">
                                    <Button Content="✎" Style="{StaticResource DataGridActionButtonStyle}" Foreground="#2D3748" Click="BewerkResultaat_Click" CommandParameter="{Binding}" />
                                    <Button Content="🗑" Style="{StaticResource DataGridActionButtonStyle}" Foreground="Red" Click="VerwijderResultaat_Click" CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </ScrollViewer>
</Page>