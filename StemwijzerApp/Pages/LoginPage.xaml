<Page x:Class="StemwijzerApp.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Login">
    <Grid Background="#EDF2F4">
        <Border Background="White" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="40" CornerRadius="8">
            <StackPanel>
                <TextBlock Text="Stemwijzer Beheer" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <TextBlock Text="E-mailadres" FontWeight="SemiBold" Margin="0,10,0,5"/>
                <TextBox x:Name="TxtEmail" Height="40" Style="{StaticResource ModernTextBoxStyle}"/>
                <TextBlock Text="Wachtwoord" FontWeight="SemiBold" Margin="0,10,0,5"/>
                <PasswordBox x:Name="PbWachtwoord" Height="40" Style="{StaticResource ModernPasswordBoxStyle}"/>
                <Button Content="Inloggen" Style="{StaticResource FormPrimaryButtonStyle}" Margin="0,20,0,0" Click="BtnLogin_Click"/>
                <Border Background="#F1F1F1" Padding="10" Margin="0,20,0,0" CornerRadius="4">
                    <TextBlock Text="Demo: admin@stemwijzer.nl / admin123" FontSize="12" HorizontalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Page>