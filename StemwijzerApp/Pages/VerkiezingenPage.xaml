<Page x:Class="StemwijzerApp.Pages.VerkiezingenPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:StemwijzerApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1300"
      Title="VerkiezingenPage" Background="#EDF2F4">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Verkiezingen" FontSize="24" VerticalAlignment="Center" Grid.Column="0" Foreground="#2D3748"></TextBlock>
            <Button Content="+ Nieuwe Verkiezing" Style="{StaticResource HeaderAccentButtonStyle}" Grid.Column="2" VerticalAlignment="Center" Click="NieuweVerkiezing_Click"/>
        </Grid>

        <Border x:Name="NieuweVerkiezingForm" Grid.Row="1" Background="White" CornerRadius="8" Padding="20" Margin="0,20,0,20" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="LblFormTitel" Text="Nieuwe Verkiezing Toevoegen" FontSize="18" FontWeight="SemiBold" Foreground="#2D3748" Margin="0,0,0,15"/>

                <TextBlock Text="Naam" Margin="0,0,0,5" Foreground="#2D3748"/>
                <TextBox x:Name="TxtNaam" Height="35" Margin="0,0,0,15"/>

                <TextBlock Text="Datum" Margin="0,0,0,5" Foreground="#2D3748"/>
                <DatePicker x:Name="DpDatum" Height="35" Margin="0,0,0,15" VerticalContentAlignment="Center"/>

                <TextBlock Text="Type" Margin="0,0,0,5" Foreground="#2D3748"/>
                <ComboBox x:Name="CmbType" Height="35" Margin="0,0,0,15" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="Landelijk" IsSelected="True"/>
                    <ComboBoxItem Content="Gemeentelijk"/>
                    <ComboBoxItem Content="Europees"/>
                </ComboBox>

                <TextBlock Text="Beschrijving" Margin="0,0,0,5" Foreground="#2D3748"/>
                <TextBox x:Name="TxtBeschrijving" Height="100" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Margin="0,0,0,15"/>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnToevoegen" Content="Toevoegen" Width="100" Height="35" Background="#212529" Foreground="White" Click="Toevoegen_Click" Margin="0,0,10,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="BtnAnnuleren" Content="Annuleren" Width="100" Height="35" Background="#8A95A5" Foreground="White" Click="Annuleren_Click" Margin="0,0,10,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" 
                  Style="{StaticResource ModernDataGridStyle}" 
                  ItemsSource="{Binding Verkiezingen}"
                  SelectionChanged="DataGrid_SelectionChanged"
                  VerticalScrollBarVisibility="Disabled"
                  PreviewMouseWheel="DataGrid_PreviewMouseWheel"
                  AutoGenerateColumns="False">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Naam" Binding="{Binding Naam}" Width="2.5*" ElementStyle="{StaticResource DataGridTextStyle}"/>
                <DataGridTextColumn Header="Datum" Binding="{Binding Datum}" Width="1.5*" ElementStyle="{StaticResource DataGridTextStyle}"/>

                <DataGridTemplateColumn Header="Type" Width="1.5*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="#EAEAEA" Height="22" CornerRadius="8" HorizontalAlignment="Left" Padding="10,3" Margin="5,0">
                                <TextBlock Text="{Binding Type}" Foreground="#4A4A4A" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Beschrijving" Binding="{Binding Beschrijving}" Width="3.5*" ElementStyle="{StaticResource DataGridTextStyle}"/>

                <DataGridTemplateColumn Header="Status" Width="1.5*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Button Content="Activeren" Click="ActiveerVerkiezing_Click" CommandParameter="{Binding}" Width="85" Height="25" Background="#8A95A5" Foreground="White" FontSize="11" FontWeight="SemiBold">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActief}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="12"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Border Background="#D4EDDA" Height="24" CornerRadius="12" HorizontalAlignment="Left" Padding="10,3" Margin="5,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActief}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="● Actief" Foreground="#155724" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Acties" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10,0">
                                <Button Content="✎" Style="{StaticResource DataGridActionButtonStyle}" Foreground="#2D3748" Click="BewerkVerkiezing_Click" CommandParameter="{Binding}" />
                                <Button Content="🗑" Style="{StaticResource DataGridActionButtonStyle}" Foreground="Red" Click="VerwijderVerkiezing_Click" CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>