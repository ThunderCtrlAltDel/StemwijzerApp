<Page x:Class="StemwijzerApp.Pages.BeheerdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:StemwijzerApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1300" Background="#EDF2F4"
      Title="BeheerdersPage"> 

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Beheerders" FontSize="24" VerticalAlignment="Center" Grid.Column="0" Foreground="#2D3748"></TextBlock>
                <Button Content="+ Nieuwe Beheerder" Style="{StaticResource HeaderAccentButtonStyle}" Grid.Column="2" VerticalAlignment="Center" Click="NieuweBeheerder_Click"></Button>
            </Grid>

            <Border x:Name="NieuweBeheerderForm" Grid.Row="1" Background="White" CornerRadius="8" Padding="25" Margin="0,20,0,20" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="LblFormTitel" Text="Nieuwe Beheerder Toevoegen" FontSize="18" FontWeight="Bold" Foreground="#2D3748" Margin="0,0,0,20"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="25"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,20">
                            <TextBlock Text="Naam" FontWeight="SemiBold" FontSize="14" Foreground="#2D3748" Margin="0,0,0,8"/>
                            <TextBox x:Name="TxtNaam" Style="{StaticResource ModernTextBoxStyle}" Height="40"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,20">
                            <TextBlock Text="E-mailadres" FontWeight="SemiBold" FontSize="14" Foreground="#2D3748" Margin="0,0,0,8"/>
                            <TextBox x:Name="TxtEmail" Style="{StaticResource ModernTextBoxStyle}" Height="40"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,25">
                            <TextBlock x:Name="LblWachtwoordTitel" Text="Wachtwoord" FontWeight="SemiBold" FontSize="14" Foreground="#2D3748" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="TxtWachtwoord" Grid.Column="0" Height="40" VerticalContentAlignment="Center" Padding="10,0,10,0" Visibility="Visible"/>
                                <TextBox x:Name="TxtWachtwoordZichtbaar" Grid.Column="0" Height="40" VerticalContentAlignment="Center" Padding="10,0,10,0" Style="{StaticResource ModernTextBoxStyle}" Visibility="Collapsed"/>
                                <Button x:Name="BtnWachtwoordZichtbaar" Content="👁️" Grid.Column="1" Width="40" Height="40" Background="Transparent" BorderBrush="{x:Null}" Foreground="#A0AEC0" FontSize="16" Cursor="Hand" Click="BtnWachtwoordZichtbaar_Click"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,25">
                            <TextBlock Text="Rol" FontWeight="SemiBold" FontSize="14" Foreground="#2D3748" Margin="0,0,0,8"/>
                            <ComboBox x:Name="CmbRol" Style="{StaticResource ModernComboBoxStyle}" Height="40">
                                <ComboBoxItem Content="Admin" IsSelected="True"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnToevoegen" Content="Toevoegen" Style="{StaticResource FormPrimaryButtonStyle}" Width="110" Margin="0,0,10,0" Click="Toevoegen_Click"/>
                        <Button Content="Annuleren" Style="{StaticResource FormSecondaryButtonStyle}" Width="110" Click="Annuleren_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <DataGrid Grid.Row="2" 
                      Style="{StaticResource ModernDataGridStyle}" 
                      ItemsSource="{Binding Beheerders}"
                      SelectionChanged="DataGrid_SelectionChanged"
                      VerticalScrollBarVisibility="Disabled"
                      PreviewMouseWheel="DataGrid_PreviewMouseWheel"
                      AutoGenerateColumns="False">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Naam" Binding="{Binding Naam}" Width="3*" ElementStyle="{StaticResource DataGridTextStyle}"/>
                    <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="3.5*" ElementStyle="{StaticResource DataGridTextStyle}"/>

                    <DataGridTemplateColumn Header="Rol" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#EAEAEA" Height="24" CornerRadius="12" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="12,0" Margin="15,0">
                                    <TextBlock Text="{Binding Rol}" Foreground="#2D3748" FontSize="13" VerticalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Aangemaakt" Binding="{Binding Aangemaakt}" Width="2*" ElementStyle="{StaticResource DataGridTextStyle}"/>

                    <DataGridTemplateColumn Header="Acties" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10,0">
                                    <Button Content="✎" Style="{StaticResource DataGridActionButtonStyle}" Foreground="#2D3748" Click="BewerkBeheerder_Click" CommandParameter="{Binding}" />
                                    <Button Content="🗑" Style="{StaticResource DataGridActionButtonStyle}" Foreground="Red" Click="VerwijderBeheerder_Click" CommandParameter="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </ScrollViewer>
</Page>