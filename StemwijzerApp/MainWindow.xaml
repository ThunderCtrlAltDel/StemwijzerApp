<Window x:Class="StemwijzerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StemwijzerApp"
        mc:Ignorable="d"
        Title="Dashboard" Height="800" Width="1300" Background="#EDF2F4">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Border x:Name="Sidebar" Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Visibility="Visible">
            <DockPanel Width="260" Margin="20,30">
                <TextBlock DockPanel.Dock="Top" Text="Stemwijzer Beheer" FontSize="20" FontWeight="Bold" Foreground="#1E293B" Margin="10,0,0,30"/>

                <Button DockPanel.Dock="Bottom" Content="Uitloggen" Style="{StaticResource MenuButtonStyle}" Margin="0,10,0,0"/>

                <StackPanel x:Name="MenuStackPanel">
                    <Button Click="BtnDashboard_Click" x:Name="BtnDashboard" Content="Dashboard" Style="{StaticResource MenuButtonStyle}"/>
                    <Button Click="BtnPartijen_Click" x:Name="BtnPartijen" Content="Politieke Partijen" Style="{StaticResource MenuButtonStyle}"/>
                    <Button Click="BtnStandpunten_Click" x:Name="BtnStandpunten" Content="Standpunten" Style="{StaticResource MenuButtonStyle}"/>
                    <Button Click="BtnVerkiezingen_Click" x:Name="BtnVerkiezingen" Content="Verkiezingen" Style="{StaticResource MenuButtonStyle}"/>
                    <Button Click="BtnStandpuntenarrangementen_Click" x:Name="BtnStandpuntenarrangementen" Content="Standpuntenarrangementen" Style="{StaticResource MenuButtonStyle}"/>
                    <Button Click="BtnGebruikers_Click" x:Name="BtnGebruikers" Content="Gebruikers" Style="{StaticResource MenuButtonStyle}"/>
                    <Button Click="BtnNieuws_Click" x:Name="BtnNieuws" Content="Nieuws" Style="{StaticResource MenuButtonStyle}"/>
                    <Button Click="BtnBeheerders_Click" x:Name="BtnBeheerders" Content="Beheerders" Style="{StaticResource MenuButtonStyle}"/>
                    <Button Click="BtnReacties_Click" x:Name="BtnReacties" Content="Reacties" Style="{StaticResource MenuButtonStyle}"/>
                    <Button Click="BtnResultaten_Click" x:Name="BtnResultaten" Content="Stemwijzer Resultaten" Style="{StaticResource MenuButtonStyle}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Frame x:Name="MainFrame" Source="Pages/DashboardPage.xaml" NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>
